# ============================================================
# Git Ignore Configuration
# ============================================================

# --- Environment Variables & Secrets ---
# Keep all secret credentials out of source control
.env
.env.local
.env.*.local
*.env
!.env.example

# --- Dependencies ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Local Runtime Database ---
# The local database file stores runtime user records.
# Sample data is provided in movies.example.json.
movies.json

# --- Private Academic Documents & Exam Files ---
# Exclude school exam instructions, lab rubrics, and progress reports
*.docx
*.pdf
use_this*
Weekly Progress*
Lab Exam*
Cinememo_Presentation_Script.*
design-system/

# --- Python Virtual Environment & Helper Scripts ---
# Exclude temporary python scripts used for report generation
venv/
.venv/
__pycache__/
*.py
*.pyc

# --- Backups & Temporary Files ---
backup/
*.bak
*.tmp
*.swp
*~

# --- Operating System & Editor Files ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
